	{"bbox_2d": [348, 798, 406, 981], "text_content": "清也从水", "size": "32.22", "type": "heading"},
	{"bbox_2d": [290, 798, 348, 981], "text_content": "此聲干禮", "size": "32.22", "type": "heading"},
	{"bbox_2d": [215, 24, 272, 449], "text_content": "切寒水也从水", "size": "32.22", "type": "heading"},
