	{"bbox_2d": [603, 169, 661, 520], "text_content": "流清皃从水劉聲詩", "size": "32.22", "type": "heading"},
	{"bbox_2d": [544, 169, 603, 510], "text_content": "曰瀏其清矣力久切", "size": "32.22", "type": "heading"},
	{"bbox_2d": [604, 675, 663, 974], "text_content": "礙流也从水蔵聲", "size": "32.22", "type": "heading"},
	{"bbox_2d": [546, 675, 605, 974], "text_content": "詩曰施罛濊濊呼", "size": "32.22", "type": "heading"},
	{"bbox_2d": [473, 24, 529, 719], "text_content": "括洅洅也从水豸聲臣鉉等曰今俗", "size": "32.22", "type": "heading"},
	{"bbox_2d": [415, 24, 473, 601], "text_content": "切別作霶霈非是普郎切", "size": "32.22", "type": "heading"},
