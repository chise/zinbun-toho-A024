	{"bbox_2d": [872, 469, 930, 900], "text_content": "湹流也从水玄聲上", "size": "32.22", "type": "heading"},
	{"bbox_2d": [810, 469, 868, 900], "text_content": "黨有沱氏縣胡畎切", "size": "32.22", "type": "heading"},
	{"bbox_2d": [734, 169, 793, 542], "text_content": "水流皃从水彪省聲詩", "size": "32.22", "type": "heading"},
	{"bbox_2d": [679, 169, 738, 516], "text_content": "曰澬池北流皮彪切", "size": "32.22", "type": "heading"},
