	{"bbox_2d": [869, 176, 919, 879], "text_content": "涸亦从水肖𣳚盡也从水肖𣳚盡也从水焦", "size": "small", "type": "description"},
	{"bbox_2d": [804, 176, 860, 888], "text_content": "水鹵舟𣳘聲相幺切𣳚聲子肖切", "size": "small", "type": "description"},
	{"bbox_2d": [927, 897, 952, 970], "text_content": "洪章", "size": "small", "type": "description"},
	{"bbox_2d": [738, 176, 793, 879], "text_content": "盡也从水曷𣳖水虚也从水幽溼", "size": "small", "type": "description"},
	{"bbox_2d": [674, 176, 728, 970], "text_content": "聲苦葛切𣳘康聲苦岡切𣳚也从", "size": "small", "type": "description"},
	{"bbox_2d": [608, 33, 662, 879], "text_content": "水一所以覆也覆而有土幽溼也从水", "size": "small", "type": "description"},
	{"bbox_2d": [543, 33, 600, 817], "text_content": "故溼也㬪省聲失入切𣳖音聲去急切", "size": "small", "type": "description"},
	{"bbox_2d": [476, 33, 532, 970], "text_content": "濁水不流也一曰窊下汗也从水免聲詩曰河", "size": "small", "type": "description"},
	{"bbox_2d": [412, 33, 468, 970], "text_content": "也从水夸聲哀都切𣳗水浼浼孟子曰汝安能", "size": "small", "type": "description"},
	{"bbox_2d": [347, 33, 402, 970], "text_content": "浼我武𣳙葴也一曰小池爲汗一曰𣳗隘下", "size": "small", "type": "description"},
	{"bbox_2d": [283, 33, 338, 970], "text_content": "鼻切𣳗涂也从水于聲烏故切𣳖也一", "size": "small", "type": "description"},
	{"bbox_2d": [217, 33, 274, 797], "text_content": "曰有湫水在周地春秋傳曰晏子之宅湫隘安", "size": "small", "type": "description"},
	{"bbox_2d": [153, 33, 209, 757], "text_content": "定朝那有湫泉从水秋聲子了切又即由切", "size": "small", "type": "description"},
	{"bbox_2d": [90, 33, 147, 970], "text_content": "水曰潤下从水平也从水隼平也从水", "size": "small", "type": "description"},
	{"bbox_2d": [26, 33, 82, 970], "text_content": "閏聲如順切𣳚聲之允切𣳖丁聲他丁", "size": "small", "type": "description"}
]
